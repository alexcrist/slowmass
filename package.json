{
  "name": "slowmass",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply slowmass --local",
    "auth:audit": "node scripts/ops/audit-auth-identity.mjs",
    "auth:schema": "node scripts/generate-auth-schema.mjs",
    "check:fast": "npm run format:check && npm run lint && npm run typecheck",
    "check": "npm run check:fast && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcrist/slowmass.git"
  },
  "description": "Private photo sharing.",
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "http_ece": "1.2.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
