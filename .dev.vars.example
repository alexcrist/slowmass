# Copy to .dev.vars. Never commit credentials.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=slowmass <hello@slowmass.com>
# Optional inbox for replies; may differ from the verified sending domain.
EMAIL_REPLY_TO=
# Used only to create the first verified member. All later joins require a member invitation.
BOOTSTRAP_EMAIL=

# Optional Google OAuth web client for http://localhost:8787 (not production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
